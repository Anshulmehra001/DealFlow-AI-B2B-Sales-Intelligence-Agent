# ═══════════════════════════════════════════════════════════════════════════
# DealFlow AI - Google Cloud Rapid Agent Hackathon 2026
# ═══════════════════════════════════════════════════════════════════════════

# MongoDB Configuration (REQUIRED for MongoDB MCP Server)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dealflow_db?retryWrites=true&w=majority
MONGODB_DATABASE=dealflow_db

# MongoDB MCP Server Environment Variables
MDB_MCP_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/dealflow_db?retryWrites=true&w=majority
MDB_MCP_READ_ONLY=false
MDB_MCP_LOG_PATH=./logs
MDB_MCP_DISABLED_TOOLS=

# Google Gemini API Configuration (REQUIRED for ADK Agents)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp

# Google Cloud Configuration (Optional)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Email Configuration (Gmail SMTP - Optional for demo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=DealFlow AI

# Application Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=your-secret-key-change-this-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Agent Configuration
MAX_CONCURRENT_AGENTS=3
AGENT_TIMEOUT_SECONDS=300
LEAD_SCORE_THRESHOLD=70

# Rate Limiting
EMAIL_DAILY_LIMIT=500
API_RATE_LIMIT=100

# Feature Flags
ENABLE_EMAIL_SENDING=true
ENABLE_WEB_SCRAPING=true
ENABLE_VECTOR_SEARCH=false

